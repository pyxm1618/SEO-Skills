{
  "discovery_autocomplete": {
    "required": ["seed", "suggestions", "country", "language", "observed_at", "source", "evidence_ref"],
    "equals": {"source": "google_autocomplete"},
    "list_min": {"suggestions": 1}
  },
  "discovery_semrush_ideas": {
    "required": ["seed", "rows", "observed_at", "metric_source", "relay_origin", "provenance_ref"],
    "equals": {"metric_source": "Semrush"},
    "host_equals": {"relay_origin": "sem.3ue.com"},
    "list_min": {"rows": 1}
  },
  "discovery_handoff": {
    "required": ["batch_id", "required_seed_count", "autocomplete_pass_count", "status"],
    "equals": {"status": "PASS"},
    "equal_fields": [["required_seed_count", "autocomplete_pass_count"]]
  },
  "trends_related": {
    "required": [
      "anchor", "related_queries", "country", "timeframe", "observed_at",
      "source", "source_type", "source_url", "raw_evidence_ref", "screenshot_ref",
      "evidence_receipt_ref"
    ],
    "equals": {"source": "Google Trends", "source_type": "google_trends_related"},
    "host_equals": {"source_url": "trends.google.com"},
    "items_required": {
      "related_queries": ["query", "relation_type", "rank", "is_google_breakout"]
    }
  },
  "trends_timeline": {
    "required": [
      "keyword", "market", "requested_timeframe", "actual_resolution", "series",
      "observed_at", "source", "source_type", "source_url", "raw_evidence_ref",
      "screenshot_ref", "evidence_receipt_ref"
    ],
    "equals": {"source": "Google Trends", "source_type": "google_trends_timeline"},
    "host_equals": {"source_url": "trends.google.com"},
    "list_min": {"series": 2},
    "items_required": {"series": ["time", "value"]}
  },
  "emerging_radar_run": {
    "required": [
      "domain", "status", "recursive_edge_policy", "supplemental_recursive",
      "anchor_pool", "candidate_counts", "blockers", "output_artifacts"
    ],
    "equals": {
      "recursive_edge_policy": "google_trends_rising_only",
      "supplemental_recursive": false
    },
    "list_min": {"anchor_pool": 1},
    "items_required": {
      "anchor_pool": ["keyword", "anchor_source", "discovery_depth"],
      "blockers": ["status", "reason"]
    }
  },
  "stage6_exact": {
    "required": [
      "keyword", "volume", "kd", "cpc", "intent", "competition_level", "trend",
      "metric_source", "metric_database", "metric_stage", "observed_at", "relay_origin", "provenance_ref"
    ],
    "equals": {"metric_source": "Semrush", "metric_database": "us", "metric_stage": "exact"},
    "host_equals": {"relay_origin": "sem.3ue.com"},
    "list_length": {"trend": 12},
    "number_range": {
      "volume": {"min": 0},
      "kd": {"min": 0, "max": 100},
      "cpc": {"min": 0}
    }
  },
  "intitle_observation": {
    "required": ["keyword", "intitle_results", "source", "market", "observed_at", "evidence_ref"],
    "equals": {"source": "Google"},
    "number_range": {"intitle_results": {"min": 0, "integer": true}}
  },
  "kgr_intitle": {
    "required": [
      "keyword", "volume", "intitle_results", "metric_source", "metric_database", "metric_stage",
      "exact_observed_at", "exact_provenance_ref", "intitle_source", "market",
      "intitle_observed_at", "intitle_provenance_ref"
    ],
    "equals": {
      "metric_source": "Semrush",
      "metric_database": "us",
      "metric_stage": "exact",
      "intitle_source": "Google"
    },
    "number_range": {
      "volume": {"min": 0},
      "intitle_results": {"min": 0, "integer": true}
    }
  },
  "serp_review": {
    "required": ["keyword", "source", "market", "observed_at", "evidence_ref", "results"],
    "equals": {"source": "Google"},
    "list_min": {"results": 10},
    "items_required": {"results": ["rank", "url"]}
  },
  "finalist_trend": {
    "required": ["keyword", "is_finalist"],
    "conditional_required": [
      {
        "when": {"field": "is_finalist", "equals": true},
        "fields": [
          "google_trends_source", "google_trends_market", "google_trends_observed_at",
          "google_trends_evidence_ref", "google_trends_series"
        ]
      }
    ],
    "conditional_equals": [
      {
        "when": {"field": "is_finalist", "equals": true},
        "field": "google_trends_source",
        "equals": "Google Trends"
      }
    ],
    "list_min": {"google_trends_series": 2},
    "items_required": {"google_trends_series": ["time", "value"]}
  }
}
