{
  "description": "SEO production-stage integrity gates. Project hooks must be reviewed and trusted before live acceptance.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 runtime/stage_hook.py pre",
            "timeout": 10,
            "statusMessage": "Checking SEO stage contract"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python3 runtime/stage_hook.py stop",
            "timeout": 10,
            "statusMessage": "Checking SEO run completeness"
          }
        ]
      }
    ]
  }
}
