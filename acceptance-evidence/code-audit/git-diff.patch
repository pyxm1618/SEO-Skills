+def load_validator():
+    spec = importlib.util.spec_from_file_location("stage_validator", VALIDATOR_PATH)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def exact_row(**overrides):
+    row = {
