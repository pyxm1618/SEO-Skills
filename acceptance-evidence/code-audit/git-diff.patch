+        "metric_database": "us",
+        "metric_stage": "exact",
+        "observed_at": "2026-08-26T10:00:00Z",
+        "relay_origin": "https://sem.3ue.com/",
+        "provenance_ref": "evidence/exact-wedding-calculator.json",
+    }
+    row.update(overrides)
+    return row
